rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // 1. Master Gate & Global Safety Net
    match /{document=**} {
      allow read, write: if false;
    }

    // 2. Reusable Primitives
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isSignedIn() && (
        request.auth.token.email.lower() == 'ruro2885@gmail.com' ||
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'super_admin'
      );
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    // 3. User Profiles & Subcollections
    match /users/{userId} {
      allow read: if isSignedIn();
      allow create: if isOwner(userId) && (
        !request.resource.data.keys().hasAny(['role']) || 
        request.resource.data.role == 'user' || 
        isAdmin()
      );
      allow update: if (isOwner(userId) && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['role'])) || isAdmin();
      allow delete: if isAdmin();

      match /{document=**} {
        allow read, write: if isOwner(userId) || isAdmin();
      }
    }

    // 4. Admin Specific Collections
    match /platform_analytics/{id} {
      allow read, write: if isAdmin();
    }
    match /platform_health/{id} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }
    match /system_settings/{id} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }
    match /support_tickets/{id} {
      allow read, create, update: if isSignedIn();
      allow delete: if isAdmin();
    }
    match /admin_audit_logs/{logId} {
      allow read, write: if isAdmin();
    }
    match /admin_deposits/{id} {
      allow read, write: if isAdmin();
    }
    match /admin_withdrawals/{id} {
      allow read, write: if isAdmin();
    }
    match /admin_kyc/{id} {
      allow read, write: if isAdmin();
    }
    match /linked_wallets/{walletId} {
      allow read: if isOwner(resource.data.userId) || isAdmin();
      allow create: if isOwner(request.resource.data.userId) || isAdmin();
      allow update, delete: if isOwner(resource.data.userId) || isAdmin();
    }

    // 5. User Bonus States
    match /wallets/{userId} {
      allow read, write: if isOwner(userId) || isAdmin();
    }

    match /userBonuses/{userId} {
      allow read, write: if isOwner(userId);
      
      match /{allPaths=**} {
        allow read, write: if isOwner(userId);
      }
    }

    // 5. Referrals (Relational logic)
    match /referrals/{referralId} {
      allow get, list: if isSignedIn() && resource.data.referrerId == request.auth.uid;
      allow create, update, delete: if isSignedIn() && request.resource.data.referrerId == request.auth.uid;
    }

    // 6. Static Data (Read-only for signed-in users)
    match /bonuses/{bonusId} {
      allow read, list: if isSignedIn();
    }

    // 7. Notifications
    match /notifications/{notificationId} {
      allow get, list: if isSignedIn() && (resource == null || resource.data.userId == request.auth.uid);
      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;
      allow update, delete: if isSignedIn() && resource.data.userId == request.auth.uid;
    }

    // 8. Global Public Data (Leaderboard)
    match /leaderboard/{userId} {
      allow read: if true;
      allow write: if isOwner(userId);
    }

    // 9. AI Trading
    match /aiPreferences/{userId} {
      allow read, write: if isOwner(userId);
    }

    match /aiSessions/{sessionId} {
      allow read, write: if isSignedIn() && (resource == null || resource.data.userId == request.auth.uid || request.resource.data.userId == request.auth.uid);
    }

    match /aiRecommendations/{recId} {
      allow read, write: if isSignedIn() && (resource == null || resource.data.userId == request.auth.uid || request.resource.data.userId == request.auth.uid);
    }

    // 10. Global Events Hub
    match /events_hub/{eventId} {
      allow read, list: if true;
      allow write, create, update, delete: if isAdmin();
    }
  }
}
